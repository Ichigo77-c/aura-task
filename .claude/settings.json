{
  "maxEffortLevel": "medium",
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/sync/node_modules/tsx/dist/cli.mjs .claude/sync/claude-hook.ts session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/sync/node_modules/tsx/dist/cli.mjs .claude/sync/claude-hook.ts prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/sync/node_modules/tsx/dist/cli.mjs .claude/sync/claude-hook.ts stop",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128",
    "ANTHROPIC_AUTH_TOKEN": "omniroute",
    "ANTHROPIC_MODEL": "omni-free",
    "ANTHROPIC_SMALL_FAST_MODEL": "omni-free",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "omni-free",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "omni-free",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "omni-free",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "131072",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
