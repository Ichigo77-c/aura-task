# Copy to keystore.properties and fill in your values.
# keystore.properties is gitignored - never commit the real one.
#
# Create a keystore with:
#   keytool -genkey -v -keystore aura-tasks.keystore -alias aura-tasks \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .keystore file somewhere safe (e.g. next to android/ or a password
# manager) - releasing an update requires the exact same key.

storeFile=../keystore/aura-tasks.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_ALIAS
keyPassword=YOUR_KEY_PASSWORD
